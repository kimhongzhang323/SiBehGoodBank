# SibehGoodBank Backend Environment Configuration
# Copy this file to .env and update values accordingly

# ==============================
# Database Configuration
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==============================
# Redis Configuration
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis-secret

# ==============================
# Kafka Configuration
# ==============================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==============================
# RabbitMQ Configuration
# ==============================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ==============================
# JWT Security (IMPORTANT: Change in production!)
# ==============================
# Access token secret - minimum 256 bits (32 characters)
JWT_ACCESS_SECRET=your-256-bit-access-token-secret-key-for-jwt-signing-must-be-secure
# Refresh token secret - minimum 256 bits (32 characters)
JWT_REFRESH_SECRET=your-256-bit-refresh-token-secret-key-for-jwt-signing-must-be-secure
# Legacy single secret (for gateway)
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing-must-be-at-least-256-bits

# Token expiration (in seconds)
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# ==============================
# Eureka Discovery Service
# ==============================
EUREKA_URI=http://eureka:eureka-secret@localhost:8761/eureka
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka-secret

# ==============================
# Config Service
# ==============================
CONFIG_USERNAME=config
CONFIG_PASSWORD=config-secret

# ==============================
# AI Agent Service (Anthropic)
# ==============================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ==============================
# Notification Service - Email
# ==============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==============================
# Notification Service - SMS (Twilio)
# ==============================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================
# Notification Service - Push (Firebase)
# ==============================
FIREBASE_CREDENTIALS_PATH=/app/config/firebase-credentials.json

# ==============================
# Encryption Keys (IMPORTANT: Change in production!)
# ==============================
# AES-256 key for data encryption (Base64 encoded)
AES_ENCRYPTION_KEY=your-base64-encoded-aes-256-key-here

# RSA key pair for asymmetric encryption (optional, can be auto-generated)
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=

# ==============================
# Monitoring
# ==============================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ==============================
# Service Ports
# ==============================
USER_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
TRANSACTION_SERVICE_PORT=8083
AI_AGENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
ANALYTICS_SERVICE_PORT=8086
API_GATEWAY_PORT=8080
DISCOVERY_SERVICE_PORT=8761
CONFIG_SERVICE_PORT=8888

# ==============================
# gRPC Ports
# ==============================
USER_SERVICE_GRPC_PORT=9081
ACCOUNT_SERVICE_GRPC_PORT=9082
TRANSACTION_SERVICE_GRPC_PORT=9083
NOTIFICATION_SERVICE_GRPC_PORT=9085

# ==============================
# Logging
# ==============================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/sibehgoodbank
